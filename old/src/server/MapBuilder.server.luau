-- MapBuilder (Script)
-- Runs once when the server starts and builds the whole map from MapData.
-- Do not edit this file to change the layout; edit ReplicatedStorage.Shared.MapData instead.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local MapData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapData"))

-- Colors and materials (placeholders)
local GROUND_COLOR = Color3.fromRGB(90, 160, 80)
local PATH_COLOR = Color3.fromRGB(194, 165, 110)
local WAYPOINT_COLOR = Color3.fromRGB(255, 220, 0)
local SPAWN_COLOR = Color3.fromRGB(60, 200, 60)
local BASE_COLOR = Color3.fromRGB(200, 50, 50)

-- Helper: makes one anchored placeholder Part at a CFrame.
local function makePart(name, size, cframe, color, material, canCollide)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = canCollide
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Remove an old build (useful if the script is re-run in Studio).
for _, oldName in ipairs({ "Map", "Waypoints" }) do
	local old = Workspace:FindFirstChild(oldName)
	if old then
		old:Destroy()
	end
end

-- Folders that hold the generated parts
local mapFolder = Instance.new("Folder")
mapFolder.Name = "Map"
mapFolder.Parent = Workspace

local waypointFolder = Instance.new("Folder")
waypointFolder.Name = "Waypoints"
waypointFolder.Parent = Workspace

local pathFolder = Instance.new("Folder")
pathFolder.Name = "Path"
pathFolder.Parent = mapFolder

-- 1) Ground: a large flat anchored Part whose top sits at Y = 0
local groundSize = MapData.GroundSize
local ground = makePart(
	"Ground",
	groundSize,
	CFrame.new(0, -groundSize.Y / 2, 0),
	GROUND_COLOR,
	Enum.Material.Grass,
	true
)
ground.Parent = mapFolder

-- 2) Waypoints: named "1", "2", "3"... so the rest of the game can sort them by number
local PATH_THICKNESS = 0.2
local width = MapData.PathWidth

for i, position in ipairs(MapData.Waypoints) do
	local wp = makePart(
		tostring(i),
		Vector3.new(2, 1, 2),
		CFrame.new(position),
		WAYPOINT_COLOR,
		Enum.Material.Neon,
		false
	)
	wp.Transparency = 0.5 -- visible, but see-through
	wp.Parent = waypointFolder

	-- Square "joint" at each waypoint so the corners of the path have no gaps
	local joint = makePart(
		"Joint" .. i,
		Vector3.new(width, PATH_THICKNESS, width),
		CFrame.new(position.X, PATH_THICKNESS / 2, position.Z),
		PATH_COLOR,
		Enum.Material.Sand,
		false
	)
	joint.Parent = pathFolder
end

-- 3) Path segments: a flat strip between each pair of points,
--    including the last waypoint -> base.
local route = {}
for _, position in ipairs(MapData.Waypoints) do
	table.insert(route, position)
end
table.insert(route, MapData.BasePosition)

-- Flatten a point onto the path's height
local function onPath(position)
	return Vector3.new(position.X, PATH_THICKNESS / 2, position.Z)
end

for i = 1, #route - 1 do
	local a = onPath(route[i])
	local b = onPath(route[i + 1])
	local length = (b - a).Magnitude
	local middle = (a + b) / 2

	-- lookAt points the part's length (Z axis) from the middle toward the next point
	local segment = makePart(
		"Segment" .. i,
		Vector3.new(width, PATH_THICKNESS, length),
		CFrame.lookAt(middle, b),
		PATH_COLOR,
		Enum.Material.Sand,
		false
	)
	segment.Parent = pathFolder
end

-- 4) Spawn marker: a flat green pad at the start of the path
local spawnPoint = MapData.Waypoints[1]
local spawnMarker = makePart(
	"SpawnMarker",
	Vector3.new(6, 0.2, 6),
	CFrame.new(spawnPoint.X, 0.3, spawnPoint.Z),
	SPAWN_COLOR,
	Enum.Material.SmoothPlastic,
	false
)
spawnMarker.Transparency = 0.2
spawnMarker.Parent = mapFolder

-- 5) Base: a tall red block at the end of the path
local basePos = MapData.BasePosition
local base = makePart(
	"Base",
	Vector3.new(10, 6, 10),
	CFrame.new(basePos.X, 3, basePos.Z),
	BASE_COLOR,
	Enum.Material.SmoothPlastic,
	false
)
base.Parent = mapFolder

print("MapBuilder: built map with " .. #MapData.Waypoints .. " waypoints")
